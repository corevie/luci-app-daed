+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2023, daeuniverse Organization <team@v2raya.org>
+ */
+
+package subscription
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	daesub "github.com/corevie/dae/common/subscription"
+	"github.com/daeuniverse/dae-wing/common"
+	"github.com/daeuniverse/dae-wing/db"
+	"github.com/sirupsen/logrus"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// LocalNodesDir is scanned at startup for drop-in node sources.
+// Each file becomes a subscription tagged after its file name and is kept
+// in sync with the file content:
+//
+//	/etc/daed/nodes.d/<tag>.json  cfMac nodes.json (resolved to echws:// links)
+//	/etc/daed/nodes.d/<tag>.txt   plain link list (one node link per line)
+//
+// The LuCI "ECH Tunnel" page (Gist sync) writes these files, so nodes
+// downloaded from a gist show up in the dashboard without manual pasting.
+var LocalNodesDir = "/etc/daed/nodes.d"
+
+// SyncReportPath is where the outcome of the last scan is published, so the
+// LuCI page can show what the daemon actually did with each drop-in instead of
+// only "the file was written". It lives on tmpfs: it describes one startup.
+var SyncReportPath = "/tmp/daed-nodes-sync.json"
+
+// syncReportEntry is the per-file import outcome surfaced to the UI.
+type syncReportEntry struct {
+	Tag    string `json:"tag"`
+	File   string `json:"file"`
+	Status string `json:"status"` // imported | skipped | invalid | failed
+	Nodes  int    `json:"nodes"`
+	// Retained counts nodes the source no longer lists but which stayed in the
+	// database because they are pinned to a group (upstream keeps those), i.e.
+	// stale entries the user may want to review.
+	Retained int    `json:"retained"`
+	Error    string `json:"error,omitempty"`
+}
+
+type syncReport struct {
+	GeneratedAt int64             `json:"generatedAt"`
+	Entries     []syncReportEntry `json:"entries"`
+}
+
+// writeSyncReport publishes the scan result atomically; failures are logged
+// only, since a missing report must never break the import itself.
+func writeSyncReport(entries []syncReportEntry) {
+	if entries == nil {
+		entries = []syncReportEntry{}
+	}
+	b, err := json.Marshal(syncReport{GeneratedAt: time.Now().Unix(), Entries: entries})
+	if err != nil {
+		logrus.Warnf("[local-nodes] marshal sync report: %v", err)
+		return
+	}
+	tmp := SyncReportPath + ".tmp"
+	if err := os.WriteFile(tmp, b, 0600); err != nil {
+		logrus.Warnf("[local-nodes] write sync report: %v", err)
+		return
+	}
+	if err := os.Rename(tmp, SyncReportPath); err != nil {
+		logrus.Warnf("[local-nodes] publish sync report: %v", err)
+	}
+}
+
+// countRetainedNodes reports how many nodes of the subscription are still in
+// the database although the freshly fetched link set no longer contains them
+// (UpdateById deliberately keeps nodes that are pinned to a group).
+func countRetainedNodes(ctx context.Context, subID uint, fetched []string) int {
+	fresh := make(map[string]struct{}, len(fetched))
+	for _, link := range fetched {
+		fresh[link] = struct{}{}
+	}
+	var nodes []db.Node
+	if err := db.DB(ctx).Where("subscription_id = ?", subID).Find(&nodes).Error; err != nil {
+		return 0
+	}
+	retained := 0
+	for _, node := range nodes {
+		if _, ok := fresh[node.Link]; !ok {
+			retained++
+		}
+	}
+	return retained
+}
+
+// SyncLocalSubscriptions imports every drop-in under LocalNodesDir as a
+// subscription and binds it to a group of the same name, so its nodes are
+// visible in the dashboard and can be referenced by routing rules.
+//
+// It is idempotent: an existing subscription with the same tag and link is
+// refreshed in place, and the group binding is created with DO NOTHING. A
+// tag already owned by another link (a user-managed subscription) is left
+// untouched instead of being hijacked -- and reported as "skipped" so the UI
+// can tell the user why nothing showed up.
+func SyncLocalSubscriptions(ctx context.Context) {
+	pruneLocalSubscriptions(ctx)
+	entries, err := os.ReadDir(LocalNodesDir)
+	if err != nil {
+		// The directory missing simply means the feature is unused; publish an
+		// empty report so the UI can distinguish "not scanned" from "no files".
+		writeSyncReport(nil)
+		return
+	}
+	report := make([]syncReportEntry, 0, len(entries))
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		name := entry.Name()
+		ext := filepath.Ext(name)
+		if ext != ".json" && ext != ".txt" {
+			continue
+		}
+		tag := strings.TrimSuffix(name, ext)
+		record := syncReportEntry{Tag: tag, File: filepath.Join(LocalNodesDir, name)}
+		if err := common.ValidateTag(tag); err != nil {
+			logrus.Warnf("[local-nodes] skip %v: %v", name, err)
+			record.Status = "invalid"
+			record.Error = err.Error()
+			report = append(report, record)
+			continue
+		}
+		link := "file://" + filepath.Join(LocalNodesDir, name)
+
+		var m db.Subscription
+		err := db.DB(ctx).Where("tag = ?", tag).First(&m).Error
+		switch {
+		case errors.Is(err, gorm.ErrRecordNotFound):
+			m = db.Subscription{
+				UpdatedAt: time.Now(),
+				Tag:       &tag,
+				Link:      link,
+				Status:    "",
+				Info:      "",
+			}
+			if err = db.DB(ctx).Create(&m).Error; err != nil {
+				logrus.Warnf("[local-nodes] create subscription %v: %v", tag, err)
+				record.Status = "failed"
+				record.Error = err.Error()
+				report = append(report, record)
+				continue
+			}
+			logrus.Infof("[local-nodes] created subscription %v from %v", tag, link)
+		case err != nil:
+			logrus.Warnf("[local-nodes] lookup subscription %v: %v", tag, err)
+			record.Status = "failed"
+			record.Error = err.Error()
+			report = append(report, record)
+			continue
+		case m.Link != link:
+			logrus.Warnf("[local-nodes] tag %v is already used by subscription %v; skip", tag, m.Link)
+			record.Status = "skipped"
+			record.Error = "the tag is already used by subscription " + m.Link
+			report = append(report, record)
+			continue
+		}
+
+		// Snapshot the links before the import so stale (pinned) leftovers can
+		// be reported afterwards.
+		fetched, fetchErr := fetchLinks(link)
+		if _, err := UpdateById(ctx, m.ID); err != nil {
+			logrus.Warnf("[local-nodes] import nodes of %v: %v", tag, err)
+			record.Status = "failed"
+			record.Error = err.Error()
+			report = append(report, record)
+			continue
+		}
+		var count int64
+		if err := db.DB(ctx).Model(&db.Node{}).Where("subscription_id = ?", m.ID).Count(&count).Error; err != nil {
+			logrus.Warnf("[local-nodes] count nodes of %v: %v", tag, err)
+		}
+		if fetchErr == nil {
+			record.Retained = countRetainedNodes(ctx, m.ID, fetched)
+		}
+		record.Status = "imported"
+		record.Nodes = int(count)
+		report = append(report, record)
+		ensureLocalGroup(ctx, tag, m.ID)
+	}
+	writeSyncReport(report)
+}
+
+// pruneLocalSubscriptions removes subscription rows previously imported from
+// drop-ins under LocalNodesDir whose backing file is gone, together with
+// their nodes, group bindings and any auto-created orphan groups.
+func pruneLocalSubscriptions(ctx context.Context) {
+	prefix := "file://" + LocalNodesDir + "/"
+	var subs []db.Subscription
+	if err := db.DB(ctx).Where("link like ?", prefix+"%").Find(&subs).Error; err != nil {
+		logrus.Warnf("[local-nodes] list drop-in subscriptions: %v", err)
+		return
+	}
+	var ids []uint
+	removedNames := make(map[string]bool)
+	for _, sub := range subs {
+		path := strings.TrimPrefix(sub.Link, "file://")
+		if _, err := os.Stat(path); err == nil {
+			continue
+		}
+		ids = append(ids, sub.ID)
+		if sub.Tag != nil {
+			removedNames[*sub.Tag] = true
+		}
+	}
+	if len(ids) == 0 {
+		return
+	}
+	tx := db.BeginTx(ctx)
+	committed := false
+	defer func() {
+		if !committed {
+			tx.Rollback()
+		}
+	}()
+	var bindings []db.GroupSubscription
+	if err := tx.Where("subscription_id in ?", ids).Find(&bindings).Error; err != nil {
+		logrus.Warnf("[local-nodes] look up group bindings: %v", err)
+		return
+	}
+	var groupIds []uint
+	for _, b := range bindings {
+		groupIds = append(groupIds, b.GroupID)
+	}
+	if err := tx.Where("subscription_id in ?", ids).Delete(&db.Node{}).Error; err != nil {
+		logrus.Warnf("[local-nodes] remove nodes: %v", err)
+		return
+	}
+	if err := tx.Where("subscription_id in ?", ids).Delete(&db.GroupSubscription{}).Error; err != nil {
+		logrus.Warnf("[local-nodes] remove group bindings: %v", err)
+		return
+	}
+	if err := tx.Where("id in ?", ids).Select(clause.Associations).Delete(&db.Subscription{}).Error; err != nil {
+		logrus.Warnf("[local-nodes] remove subscriptions: %v", err)
+		return
+	}
+	for _, id := range ids {
+		RemoveUpdateScheduler(id)
+	}
+	for _, groupId := range groupIds {
+		var count int64
+		if err := tx.Model(&db.GroupSubscription{}).Where("group_id = ?", groupId).Count(&count).Error; err != nil {
+			continue
+		}
+		if count > 0 {
+			continue
+		}
+		var g db.Group
+		if err := tx.Where("id = ?", groupId).First(&g).Error; err != nil {
+			continue
+		}
+		if g.SystemID != nil || !removedNames[g.Name] {
+			continue
+		}
+		if err := tx.Where("group_id = ?", groupId).Delete(&db.GroupPolicyParam{}).Error; err != nil {
+			logrus.Warnf("[local-nodes] remove group policy params: %v", err)
+			continue
+		}
+		if err := tx.Where("id = ?", groupId).Delete(&db.Group{}).Error; err != nil {
+			logrus.Warnf("[local-nodes] remove orphan group: %v", err)
+		}
+	}
+	if err := tx.Commit().Error; err != nil {
+		logrus.Warnf("[local-nodes] commit prune: %v", err)
+		return
+	}
+	committed = true
+	logrus.Infof("[local-nodes] removed %v stale drop-in subscription(s)", len(ids))
+}
+
+// ensureLocalGroup makes sure a group named after the subscription exists
+// and is bound to it. New groups use the min_moving_avg policy; an existing
+// group keeps its own settings and is only bound.
+func ensureLocalGroup(ctx context.Context, name string, subscriptionID uint) {
+	var g db.Group
+	err := db.DB(ctx).Where(&db.Group{Name: name}).First(&g).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		g = db.Group{Name: name, Policy: "min_moving_avg"}
+		if err = db.DB(ctx).Create(&g).Error; err != nil {
+			logrus.Warnf("[local-nodes] create group %v: %v", name, err)
+			return
+		}
+		logrus.Infof("[local-nodes] created group %v for subscription %v", name, name)
+	} else if err != nil {
+		logrus.Warnf("[local-nodes] lookup group %v: %v", name, err)
+		return
+	}
+	binding := db.GroupSubscription{GroupID: g.ID, SubscriptionID: subscriptionID}
+	if err := db.DB(ctx).Clauses(clause.OnConflict{DoNothing: true}).Create(&binding).Error; err != nil {
+		logrus.Warnf("[local-nodes] bind group %v to subscription %v: %v", name, subscriptionID, err)
+	}
+}
+
+// resolveSubscriptionContent converts a subscription payload into node
+// links. The cfMac nodes.json format is recognized first, then SIP008, then
+// plain base64 / plaintext link lists (the same order as dae's own
+// subscription resolver).
+func resolveSubscriptionContent(b []byte) (links []string, err error) {
+	noLogger := logrus.New()
+	noLogger.SetOutput(io.Discard)
+
+	if daesub.LooksLikeCfMacNodes(b) {
+		if links, err = daesub.ResolveSubscriptionAsCfMacNodes(b); err == nil && len(links) > 0 {
+			return links, nil
+		}
+		logrus.Debugf("[subscription] cfMac nodes.json resolution failed: %v", err)
+	}
+	if links, err = daesub.ResolveSubscriptionAsSIP008(noLogger, b); err == nil && len(links) > 0 {
+		return links, nil
+	}
+	// Plain line lists (not base64) before the base64 fallback, whose decoder
+	// simply fails on them -- this is what makes <tag>.txt work.
+	if links = daesub.ResolveSubscriptionAsPlaintext(b); len(links) > 0 {
+		return links, nil
+	}
+	links = daesub.ResolveSubscriptionAsBase64(noLogger, b)
+	if len(links) == 0 {
+		return nil, errors.New("fetched but no any node was found")
+	}
+	return links, nil
+}
