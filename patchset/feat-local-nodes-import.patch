+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2022-2026, daeuniverse Organization <dae@v2raya.org>
+ *
+ * Drop-in config fragments for the dashboard build.
+ *
+ * The dashboard keeps globals, DNS, routing, nodes and subscriptions in its
+ * database, so those never come from files. The ECH tunnel has no database
+ * representation: the LuCI "ECH Tunnel" page writes it as an ech_tunnel
+ * section into <dir>/*.dae, and this is what feeds that section to the core.
+ */
+
+package dae
+
+import (
+	"os"
+	"path/filepath"
+
+	daeConfig "github.com/corevie/dae/config"
+	"github.com/corevie/dae/pkg/config_parser"
+	"github.com/sirupsen/logrus"
+)
+
+// EchTunnelFragmentDir is scanned on every config load for *.dae fragments.
+var EchTunnelFragmentDir = "/etc/daed"
+
+// MergeEchTunnelFragments applies the ech_tunnel section found in the *.dae
+// fragments under dir to c. Only that section is taken from fragments: the
+// database stays authoritative for everything else, so a stray global/routing
+// block in an edited fragment cannot override the dashboard.
+//
+// Fragments that cannot be parsed, are writable by group/others, or declare
+// the section twice are reported and skipped rather than taken as fatal: the
+// tunnel is optional, the rest of the config is not.
+func MergeEchTunnelFragments(c *daeConfig.Config, dir string) error {
+	if c == nil || dir == "" {
+		return nil
+	}
+	paths, err := filepath.Glob(filepath.Join(dir, "*.dae"))
+	if err != nil || len(paths) == 0 {
+		return nil
+	}
+	var sections []*config_parser.Section
+	for _, path := range paths {
+		fi, err := os.Stat(path)
+		if err != nil {
+			continue
+		}
+		// Same rule dae applies to config files: refuse to load a tunnel
+		// definition that any local user could rewrite.
+		if perm := fi.Mode().Perm(); perm&0037 != 0 {
+			logrus.Warnf("[ech_tunnel] %v has mode %04o (writable by group/others); skipping", path, perm)
+			continue
+		}
+		b, err := os.ReadFile(path)
+		if err != nil {
+			logrus.Warnf("[ech_tunnel] read %v: %v", path, err)
+			continue
+		}
+		parsed, err := config_parser.Parse(string(b))
+		if err != nil {
+			logrus.Warnf("[ech_tunnel] parse %v: %v", path, err)
+			continue
+		}
+		for _, section := range parsed {
+			if section != nil && section.Name == "ech_tunnel" {
+				logrus.Infof("[ech_tunnel] using section from %v", path)
+				sections = append(sections, section)
+			}
+		}
+	}
+	if len(sections) == 0 {
+		return nil
+	}
+	tunnel, err := daeConfig.ParseEchTunnelSections(sections)
+	if err != nil {
+		return err
+	}
+	if tunnel == nil {
+		return nil
+	}
+	c.EchTunnel = tunnel
+	return nil
+}
