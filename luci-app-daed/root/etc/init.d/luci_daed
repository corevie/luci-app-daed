#!/bin/sh /etc/rc.common
# Copyright (C) 2023 Tianling Shen <cnsztl@immortalwrt.org>
# Companion init for luci-app-daed: geo asset env injection and resolv.conf
# isolation for the standalone dae binary. (Subscription auto-update cron is
# managed by /etc/init.d/dae itself.)

USE_PROCD=0
START=98

CONF="daed"
RESOLV_DAED="/tmp/resolv.conf.dae"

hijack_resolv_conf() {
    grep -q ' /tmp/resolv\.conf ' /proc/mounts && return 0

    grep -E '^(search|domain) ' /tmp/resolv.conf > "$RESOLV_DAED" 2>/dev/null

    local dns_list LOGICAL_WAN
    . /lib/functions/network.sh
    network_find_wan LOGICAL_WAN 2>/dev/null
    if [ -n "$LOGICAL_WAN" ]; then
        dns_list=$(ubus call "network.interface.$LOGICAL_WAN" status 2>/dev/null | \
            jsonfilter -e '@["dns-server"][*]' 2>/dev/null)
    fi

    if [ -z "$dns_list" ] && [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ]; then
        dns_list=$(awk '/^nameserver/{print $2}' "/tmp/resolv.conf.d/resolv.conf.auto")
    fi

    [ -z "$dns_list" ] && dns_list="119.29.29.29 223.5.5.5"

    for dns in $dns_list; do
        echo "nameserver $dns" >> "$RESOLV_DAED"
    done

    mount --bind "$RESOLV_DAED" /tmp/resolv.conf
    mount -o remount,ro,bind /tmp/resolv.conf
}

restore_resolv_conf() {
  grep -q ' /tmp/resolv\.conf ' /proc/mounts || return 0
  mount -o remount,rw,bind /tmp/resolv.conf 2>/dev/null
  umount /tmp/resolv.conf 2>/dev/null
  rm -f "$RESOLV_DAED"
}

update_cron() {
  local temp_cron="/tmp/root.cron"

  if [ -f /etc/crontabs/root ]; then
    grep -v '/etc/init.d/daed restart' /etc/crontabs/root 2>/dev/null \
      | grep -v 'daed-gist-sync' > "$temp_cron"
  fi
  : >> "$temp_cron"

  local auto_update gist_sync
  auto_update=$(uci -q get daed.config.subscribe_auto_update)
  gist_sync=$(uci -q get daed.gist.enabled)
  local gist_id
  gist_id=$(uci -q get daed.gist.gist_id)

  # Sanitize cron fields: anything outside the safe character set or an
  # out-of-range value falls back to '*' so a malformed UCI value cannot
  # corrupt (or inject into) the crontab.
  local hr wk
  hr=$(uci -q get daed.config.subscribe_update_day_time)
  wk=$(uci -q get daed.config.subscribe_update_week_time)
  case "$hr" in *[!0-9]*|"") hr='*' ;; esac
  [ "$hr" != "*" ] && [ "$hr" -gt 23 ] 2>/dev/null && hr='*'
  case "$wk" in *[!0-7*,/-]*|"") wk='*' ;; esac

  if [ "$1" = "add" ]; then
    local min=$((RANDOM % 60))
    if [ "${auto_update:-0}" -eq 1 ]; then
      echo "$min $hr * * $wk /etc/init.d/daed restart >/dev/null 2>&1" >> "$temp_cron"
    fi
    # Gist sync: the script writes nodes.d/<tag>.json and restarts daed
    # itself when the payload changed.
    if [ "${gist_sync:-0}" -eq 1 ] && [ -n "$gist_id" ]; then
      echo "$min $hr * * $wk /usr/libexec/daed-gist-sync >/dev/null 2>&1" >> "$temp_cron"
    fi
  fi

  crontab "$temp_cron" 2>/dev/null
  rm -f "$temp_cron"
}

start_service() {
  # Inject the geodata location into the dae init script (idempotent).
  [ -f "/etc/init.d/dae" ] && grep -q "DAE_LOCATION_ASSET" "/etc/init.d/dae" || \
    sed -i '/procd_set_param command/i\  procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray"' "/etc/init.d/dae"
  config_load "$CONF"

  local enabled
  config_get_bool enabled "config" "enabled" "0"
  if [ "$enabled" -eq 0 ]; then
    update_cron "remove"
    restore_resolv_conf
    return 1
  fi
  update_cron "add"
  hijack_resolv_conf
}

stop_service() {
  update_cron "remove"
  restore_resolv_conf
}

service_triggers() {
  procd_add_reload_trigger "$CONF"
}
