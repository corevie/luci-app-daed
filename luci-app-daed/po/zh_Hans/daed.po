msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8"

msgid "DAED"
msgstr "DAED"

msgid "DAE is a Linux high-performance transparent proxy solution based on eBPF, And DAED is a modern dashboard for dae."
msgstr "DAE 是一个基于 eBPF 的 Linux 高性能透明代理解决方案。本构建提供独立版 dae 二进制（runfiles 模式，/etc/dae）。"

msgid "Base Setting"
msgstr "基本设置"

msgid "Dashboard"
msgstr "仪表板"

msgid "Logs"
msgstr "日志"

msgid "Clear logs"
msgstr "清空日志"

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Collecting data..."
msgstr "收集数据..."

msgid "Logfile retention count"
msgstr "日志文件保留数量"

msgid "Logfile Max Size (MB)"
msgstr "日志文件大小(MB)"

msgid "Update Cycle"
msgstr "更新周期"

msgid "Update Time (Every Day)"
msgstr "更新时间(每天)"

msgid "Username"
msgstr "用户名"

msgid "Password"
msgstr "密码"

msgid "Enable"
msgstr "启用"

msgid "ECH Tunnel"
msgstr "ECH 隧道"

msgid "Relay traffic through a wss tunnel server using TLS 1.3 Encrypted Client Hello (ECH). The tunnel can serve a local SOCKS5/HTTP proxy and/or be used as an echws:// node in dae routing."
msgstr "通过 TLS 1.3 加密客户端问候（ECH）经 wss 隧道服务器中转流量。隧道可提供本地 SOCKS5/HTTP 代理，也可作为 echws:// 节点用于 dae 路由。"

msgid "ECH Tunnel Settings"
msgstr "ECH 隧道设置"

msgid "Tunnel Server"
msgstr "隧道服务器"

msgid "The wss tunnel server in host:port[/path] form, e.g. your-worker.workers.dev:443/tunnel"
msgstr "wss 隧道服务器，格式为 host:port[/路径]，例如 your-worker.workers.dev:443/tunnel"

msgid "Server is required when ECH tunnel is enabled"
msgstr "启用 ECH 隧道时必须填写服务器"

msgid "Server must not contain quotes or control characters"
msgstr "服务器地址不能包含引号或控制字符"

msgid "Invalid server, expected host:port[/path]"
msgstr "无效的服务器地址，应为 host:port[/路径] 格式"

msgid "Port must be within 1..65535"
msgstr "端口必须在 1..65535 之间"

msgid "Local Proxy Listen Address"
msgstr "本地代理监听地址"

msgid "Local SOCKS5/HTTP proxy address. Both protocols share this port; SOCKS5 UDP is supported for DNS only (answered via DoH over ECH)."
msgstr "本地 SOCKS5/HTTP 代理监听地址。两种协议共用同一端口；SOCKS5 UDP 仅支持 DNS（经 ECH 上的 DoH 应答）。"

msgid "Listen address is required"
msgstr "必须填写监听地址"

msgid "Invalid listen address, expected host:port (e.g. 127.0.0.1:1080)"
msgstr "无效的监听地址，应为 host:port（例如 127.0.0.1:1080）"

msgid "Fixed Server IP (optional)"
msgstr "固定服务器 IP（可选）"

msgid "Pin the TCP connection to this IP while keeping the TLS SNI of the server, e.g. a Cloudflare anycast IP."
msgstr "将 TCP 连接固定到此 IP，同时保留服务器的 TLS SNI，例如 Cloudflare 任播 IP。"

msgid "Invalid IP address"
msgstr "无效的 IP 地址"

msgid "Auth Token (optional)"
msgstr "认证令牌（可选）"

msgid "Sent as the websocket subprotocol for authentication."
msgstr "作为 websocket 子协议发送，用于认证。"

msgid "DoH Server for ECH Config"
msgstr "获取 ECH 配置的 DoH 服务器"

msgid "DoH server used to fetch the ECH config (HTTPS DNS record)."
msgstr "用于获取 ECH 配置（HTTPS DNS 记录）的 DoH 服务器。"

msgid "ECH Config Domain"
msgstr "ECH 配置域名"

msgid "Domain queried for its HTTPS (type 65) record carrying the ECH config list."
msgstr "查询其 HTTPS（类型 65）记录以获取 ECH 配置列表的域名。"

msgid "Also Generate echws:// Node"
msgstr "同时生成 echws:// 节点"

msgid "Additionally write an echws:// node and an \"ech_tunnel\" group into the runfile, so routing rules can use the outbound ech_tunnel (e.g. fallback: ech_tunnel)."
msgstr "在运行文件中额外写入一个 echws:// 节点和 \"ech_tunnel\" 分组，供路由规则使用出站 ech_tunnel（例如 fallback: ech_tunnel）。"

msgid "Generated Runfile Path"
msgstr "生成的运行文件路径"

msgid "Runfile path is required"
msgstr "必须填写运行文件路径"

msgid "Runfile path must be absolute and must not contain quotes"
msgstr "运行文件路径必须为绝对路径且不能包含引号"

msgid "ENABLED"
msgstr "已启用"

msgid "DISABLED"
msgstr "已停用"

msgid "Local proxy"
msgstr "本地代理"

msgid "LISTENING"
msgstr "监听中"

msgid "NOT LISTENING"
msgstr "未监听"

msgid "Runfile"
msgstr "运行文件"

msgid "GENERATED"
msgstr "已生成"

msgid "MISSING"
msgstr "缺失"

msgid "Daemon"
msgstr "守护进程"

msgid "dae is a Linux high-performance transparent proxy solution based on eBPF. This build ships the standalone dae binary (runfiles mode, /etc/dae)."
msgstr "dae 是基于 eBPF 的 Linux 高性能透明代理解决方案。本构建提供独立版 dae 二进制（runfiles 模式，/etc/dae）。"

msgid "Config Entry File"
msgstr "配置入口文件"

msgid "Set the DAED listen address"
msgstr "设置监听地址"

msgid "Dashboard Access Port"
msgstr "仪表板访问端口"

msgid "Leave empty to use listen port"
msgstr "留空则使用监听端口"

msgid "For reverse proxy scenarios, leave empty to use the port from listen address"
msgstr "用于反向代理场景,留空则使用监听地址的端口"

msgid "DAED is not running"
msgstr "DAED 未运行"

msgid "Please start the DAED service first and try again"
msgstr "请先启动 DAED 服务后重试"

msgid "Update Cycle (Weekday)"
msgstr "更新周期（星期）"

msgid "Cron weekday: * = every day, 1-5 = Mon-Fri, 0/7 = Sunday."
msgstr "Cron 星期：* = 每天，1-5 = 周一至周五，0/7 = 周日。"

msgid "Periodically restart daed so subscriptions (e.g. the ECH nodes gist) are re-fetched."
msgstr "周期性重启 daed，以便重新拉取订阅（例如 ECH 节点 gist）。"

msgid "Connecting to the DAED dashboard…"
msgstr "正在连接 DAED 仪表板…"

msgid "Cannot determine the dashboard port. Set Dashboard Access Port in Base Setting."
msgstr "无法确定仪表板端口。请在基础设置中填写 Dashboard Access Port。"

msgid "Cannot reach the DAED dashboard."
msgstr "无法访问 DAED 仪表板。"

msgid "Check that the daemon is running and listens on this port."
msgstr "请确认守护进程正在运行且监听该端口。"

msgid "Log is empty"
msgstr "日志为空"

msgid "Failed to fetch logs"
msgstr "读取日志失败"

msgid "Log cleared"
msgstr "日志已清空"

msgid "Failed to clear log"
msgstr "清空日志失败"

msgid "Config Files"
msgstr "配置文件"

msgid "Edit the dae runfiles under /etc/daed/ (e.g. ECH tunnel fragments). The daemon restarts on save."
msgstr "编辑 /etc/daed/ 下的 dae 运行文件（如 ECH 隧道片段）。保存后守护进程将重启。"

msgid "Edit the dae runfiles under /etc/daed/ (e.g. ECH tunnel fragments). The daemon restarts on save. In the dashboard build, wing.db is authoritative for nodes/subscriptions/routing; these files are the ECH/gist bridge."
msgstr "编辑 /etc/daed/ 下的 dae 运行文件（如 ECH 隧道片段）。保存后守护进程将重启。仪表板模式下 wing.db 是节点/订阅/路由的权威数据源；这些文件是 ECH/gist 桥接文件。"

msgid "Save & Apply"
msgstr "保存并应用"

msgid "Gist Sync (cfMac nodes.json)"
msgstr "Gist 同步（cfMac nodes.json）"

msgid "Enable Gist Sync"
msgstr "启用 Gist 同步"

msgid "Gist ID"
msgstr "Gist ID"

msgid "The gist holding nodes.json (the ID from its URL)."
msgstr "存放 nodes.json 的 Gist（取其 URL 中的 ID）。"

msgid "Gist ID is required when Gist sync is enabled"
msgstr "启用 Gist 同步时必须填写 Gist ID"

msgid "Invalid Gist ID"
msgstr "无效的 Gist ID"

msgid "GitHub Token (for private gists)"
msgstr "GitHub Token（私有 Gist 用）"

msgid "Gist Filename"
msgstr "Gist 文件名"

msgid "File name inside the gist."
msgstr "Gist 中的文件名。"

msgid "Subscription Tag"
msgstr "订阅标签"

msgid "Download & Update Nodes"
msgstr "下载并更新节点"

msgid "Download"
msgstr "下载"

msgid "Downloading..."
msgstr "下载中..."

msgid "Downloaded"
msgstr "已下载"

msgid "nodes"
msgstr "个节点"

msgid "Download failed"
msgstr "下载失败"

msgid "unknown error"
msgstr "未知错误"

msgid "Invalid subscription tag"
msgstr "无效的订阅标签"

msgid "Cannot reach the GitHub API (check the network, Gist ID and token)"
msgstr "无法访问 GitHub API（请检查网络、Gist ID 与令牌）"

msgid "Unexpected GitHub API response (check the Gist ID and token)"
msgstr "GitHub API 响应异常（请检查 Gist ID 与令牌）"

msgid "Gist has no such file: %s"
msgstr "Gist 中不存在该文件：%s"

msgid "Failed to download the gist raw file"
msgstr "下载 gist 原始文件失败"

msgid "The gist raw file is empty"
msgstr "gist 原始文件为空"

msgid "The gist file has neither content nor a raw_url"
msgstr "gist 文件既无内容也无 raw_url"

msgid "Cannot write %s"
msgstr "无法写入 %s"

msgid "daed is restarting; the nodes will appear in the dashboard shortly"
msgstr "daed 正在重启，稍后即可在仪表盘中看到这些节点"

msgid "daed is not running; the nodes will be imported on next start"
msgstr "daed 未运行，节点将在下次启动时导入"

msgid "Gist Sync"
msgstr "Gist 同步"

msgid "Invalid weekday, expected 0-7 with optional , - * / (e.g. * or 1,3,5)"
msgstr "无效的星期值，应使用 0-7 及可选的 , - * /（例如 * 或 1,3,5）"

msgid "Save failed"
msgstr "保存失败"

msgid "check the network and retry"
msgstr "请检查网络后重试"

msgid "Run the download below on a schedule: the gist is fetched into /etc/daed/nodes.d/<subscription tag>.json and daed is restarted, so the nodes stay in sync without clicking the button. Every node becomes an echws:// outbound (name, token, preferred IPs, ECH DoH are all mapped)."
msgstr "按计划定时执行下方下载：Gist 内容拉取到 /etc/daed/nodes.d/<订阅标签>.json 并重启 daed，无需手动点击即可保持节点同步。每个节点都会转换为 echws:// 出站（名称、令牌、优选 IP、ECH DoH 全部映射）。"

msgid "Name of the drop-in file (/etc/daed/nodes.d/<tag>.json). The daemon imports it as a subscription with this tag plus a group of the same name, so routing rules can reference the group (e.g. fallback: ech_nodes)."
msgstr "投递文件名（/etc/daed/nodes.d/<标签>.json）。守护进程会将其导入为同名订阅并创建同名分组，路由规则可直接引用该分组（例如 fallback: ech_nodes）。"

msgid "Personal access token with the gist scope. Leave empty for public gists. The token is stored in plaintext in /etc/config/daed; the fetched node links (which carry the tunnel token) are stored in /etc/daed/nodes.d/<tag>.json with mode 0600. Do not reuse a high-privilege token."
msgstr "具有 gist 权限的个人访问令牌。公开 Gist 留空。该令牌以明文存于 /etc/config/daed；下载的节点链接（内含隧道令牌）存放于 /etc/daed/nodes.d/<标签>.json（权限 0600）。请勿复用高权限令牌。"

msgid "Accepts cfMac nodes.json, SIP008, a base64 subscription or a link list — the same formats the daemon imports. Enabling Gist Sync runs the very same download on a schedule."
msgstr "接受 cfMac nodes.json、SIP008、base64 订阅或链接列表——与守护进程支持的格式一致。启用「Gist 同步」会按相同方式定时下载。"

msgid "The gist file is an HTML page, not a node library (check the Gist ID and token)"
msgstr "该 Gist 文件是 HTML 页面而非节点库（请检查 Gist ID 与令牌）"

msgid "Gist file %s is not a node library the daemon can import (cfMac nodes.json, SIP008, base64 or link list)"
msgstr "Gist 文件 %s 不是守护进程可导入的节点库（需为 cfMac nodes.json、SIP008、base64 或链接列表）"

msgid "daed restarts on the next scheduled update; the nodes appear then"
msgstr "daed 将在下次计划更新时重启，届时节点会出现"

msgid "Nodes are already up to date; daed was not restarted"
msgstr "节点已是最新，未重启 daed"

msgid "Node drop-ins"
msgstr "节点投递文件"

msgid "waiting for the daemon import"
msgstr "等待守护进程导入"

msgid "imported"
msgstr "已导入"

msgid "import failed"
msgstr "导入失败"

msgid "skipped"
msgstr "已跳过"

msgid "unusable file"
msgstr "文件不可用"

msgid "the tag is already used by another subscription"
msgstr "该标签已被其它订阅占用"

msgid "stale nodes kept because they are pinned to a group"
msgstr "因被固定到分组而保留的旧节点"

msgid "The daemon has not scanned the drop-ins yet; restart daed to import them."
msgstr "守护进程尚未扫描投递文件；重启 daed 即可导入。"

msgid "only the Download button runs"
msgstr "仅在点击「下载」时执行"

msgid "unchanged"
msgstr "内容未变化"

msgid "none"
msgstr "无"

msgid "Enable Subscription Auto Update"
msgstr "启用订阅自动更新"

msgid "Global Settings"
msgstr "全局设置"

msgid "Only for external port mapping / reverse proxy scenarios: the daemon itself does NOT listen on this port. Leave empty to use the port from listen address."
msgstr "仅用于外网端口映射 / 反向代理场景：守护进程本身不监听该端口。留空则使用监听地址中的端口。"

msgid "Fetch the gist now, overwrite /etc/daed/nodes.d/<tag>.json and restart daed. Each entry becomes an echws:// node named after the \"name\" field, and the nodes appear in the dashboard's subscriptions and group list."
msgstr "立即拉取 Gist，覆盖 /etc/daed/nodes.d/<标签>.json 并重启 daed。每个节点按 nodes.json 的 \"name\" 字段命名并转为 echws:// 节点，随后会出现在仪表盘的订阅与分组列表中。"

msgid "Path of the generated dae config fragment. The dashboard daemon merges the ech_tunnel section of every *.dae in /etc/daed on each config load, so keep the default (or any other path inside /etc/daed) for daed. A path outside /etc/daed (e.g. /etc/dae/config.d/ech_tunnel.dae) only takes effect in the standalone dae build, which reads it through an include directive."
msgstr "生成的 dae 配置片段路径。仪表板守护进程每次加载配置时会合并 /etc/daed 下所有 *.dae 中的 ech_tunnel 段，因此 daed 请保持默认（或 /etc/daed 内的其他路径）。/etc/daed 之外的路径（例如 /etc/dae/config.d/ech_tunnel.dae）仅在独立版 dae 中生效（通过 include 指令读取）。"

msgid "When enabled, the ech_tunnel runfile is generated and the daemon is restarted. Turning it off removes the runfile. The dashboard daemon merges the fragment's ech_tunnel section on every config load; the runfile path must stay inside /etc/daed for that to happen."
msgstr "启用后将生成 ech_tunnel 运行文件并重启守护进程；关闭时会删除该文件。仪表板守护进程每次加载配置都会合并该片段中的 ech_tunnel 段，因此运行文件路径必须位于 /etc/daed 内。"

msgid "outside /etc/daed — the daemon does not read this path (standalone dae only)"
msgstr "不在 /etc/daed 内 —— 守护进程不会读取该路径（仅独立版 dae 生效）"
