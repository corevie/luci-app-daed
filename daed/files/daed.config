
config daed 'config'
	option enabled '0'
	option listen_addr '0.0.0.0:2023'
	option log_maxbackups '1'
	option log_maxsize '5'

config ech 'ech'
	option enabled '0'
	option server ''
	option listen '127.0.0.1:1080'
	option ip ''
	option token ''
	option dns 'dns.alidns.com/dns-query'
	option ech_domain 'cloudflare-ech.com'
	option gen_node '0'
	option config_file '/etc/daed/ech_tunnel.dae'

config gist 'gist'
	option enabled '0'
	option token ''
	option gist_id ''
	option gist_file 'nodes.json'
	option sub_tag 'ech_nodes'
	option persist '1'
